{
  "name": "tigrinho",
  "version": "2.2.0",
  "description": "TIGRINHO — caça-níquel casual com fichas fictícias (vanilla JS + SVG + WebAudio). Mascote: cachorro caramelo. Referência slot-game (MIT) vendorizada.",
  "type": "commonjs",
  "scripts": {
    "test": "node jogo/engine.test.js",
    "test:verbose": "node jogo/engine.test.js --verbose",
    "lint": "eslint . && node -e \"require('./jogo/config.js')\" && echo LINT_OK",
    "serve": "python3 -m http.server 8000 --directory jogo",
    "test:ui": "playwright test",
    "test:ui:report": "playwright show-report"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  }
}
